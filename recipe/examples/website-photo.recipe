            "unit" : "tbsp"
          }
        ],
        "text" : "Mix the chicken with 100ml coconut milk, the curry powder, 1 tbsp red curry paste and 1 tbsp soy sauce. Leave to marinate for 10 minutes."
      },
      {
        "id" : "step-2",
        "ingredients" : [
          {
            "amount" : 300,
            "ingredientId" : "67c744e8-26c1-4c32-8543-c7c15a2f4f5c",
            "unit" : "ml"
          },
          {
            "ingredientId" : "0ece944e-e49b-446c-8ecf-b149ea933c35"
          },
          {
            "amount" : 1,
            "ingredientId" : "1b1716da-d184-4a5c-b105-1aadee324051",
            "unit" : "tbsp"
          },
          {
            "amount" : 1,
            "ingredientId" : "5c4e563c-201e-42ca-b6a1-72361e657bd1",
            "unit" : "tbsp"
          },
          {
            "ingredientId" : "c466d2b7-7118-489c-913d-216d216f5c29"
          },
          {
            "ingredientId" : "lime-92b309bdec"
          }
        ],
        "text" : "Meanwhile, add the remaining 300ml coconut milk, peanut butter, remaining 1 tbsp red curry paste, remaining 1 tbsp soy sauce, honey and the juice of half the lime to a small saucepan. Cook over a low heat for 5 minutes, stirring regularly, until smooth and glossy."
      },
      {
        "id" : "step-3",
        "ingredients" : [
          {
            "ingredientId" : "efb49469-6562-4abd-b238-68acb0cf4357"
          }
        ],
        "text" : "If the peanut sauce is too thick, stir in water 1 tbsp at a time until it is thick but pourable, then keep warm over a very low heat."
      },
      {
        "id" : "step-4",
        "ingredients" : [
          {
            "ingredientId" : "cd846177-e3b7-45c7-bca1-04d30dd78698"
          },
          {
            "ingredientId" : "59cc816f-853d-467f-854a-831246fec3ed"
          }
        ],
        "text" : "Heat the vegetable oil in a large non-stick frying pan over a medium-high heat. Add the chicken in a single layer and cook for 8 minutes, turning occasionally, until browned and cooked through."
      },
      {
        "id" : "step-5",
        "ingredients" : [
          {
            "ingredientId" : "ac4638cb-8d98-453e-a40f-7bb4fe78baa2"
          },
          {
            "ingredientId" : "lime-92b309bdec"
          }
        ],
        "text" : "Taste the peanut sauce and season with salt if needed. Cut the remaining half lime into wedges."
      },
      {
        "id" : "step-6",
        "ingredients" : [
          {
            "ingredientId" : "59cc816f-853d-467f-854a-831246fec3ed"
          },
          {
            "ingredientId" : "0ece944e-e49b-446c-8ecf-b149ea933c35"
          }
        ],
        "text" : "Divide the chicken between plates and spoon over the warm peanut sauce, or serve the sauce alongside. Finish with the lime wedges."
      }
