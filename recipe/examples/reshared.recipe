            "amount" : 1,
            "ingredientId" : "ingredient-limes-cecbcd8c8f"
          }
        ],
        "text" : "Mix the gochujang, soy sauce and honey with the juice of the limes and a splash of water to make the sauce."
      },
      {
        "id" : "step-2",
        "ingredients" : [
          {
            "amount" : 0.5,
            "ingredientId" : "ingredient-vegetable-oil-10bd436c71",
            "unit" : "tbsp"
          },
          {
            "ingredientId" : "ingredient-free-range-pork-mince-1bb1f801d2"
          }
        ],
        "text" : "Heat ½ tbsp of the vegetable oil in a large non-stick frying pan over a high heat. Add the pork mince and cook for 7 minutes, breaking it up with a wooden spoon, until browned and cooked through."
      },
      {
        "id" : "step-3",
        "ingredients" : [
          {
            "ingredientId" : "ingredient-garlic-3d6184f88f"
          },
          {
            "ingredientId" : "ingredient-gochujang-paste-f37667f68c"
          },
          {
            "ingredientId" : "ingredient-tamari-12723e2d6a"
          },
          {
            "ingredientId" : "ingredient-honey-da82b6e865"
          }
        ],
        "text" : "Add the garlic and half the gochujang sauce to the pork. Cook for 1 minute, stirring, until the pork is glossy and coated. Transfer the pork to a plate."
      },
      {
        "id" : "step-4",
        "ingredients" : [
          {
            "amount" : 0.5,
            "ingredientId" : "ingredient-vegetable-oil-10bd436c71",
            "unit" : "tbsp"
          },
          {
            "ingredientId" : "ingredient-carrots-a98e2b33cc"
          }
        ],
        "text" : "Add the remaining ½ tbsp vegetable oil to the same pan. Add the carrots and cook over a medium-high heat for 3 minutes until starting to soften."
      },
      {
        "id" : "step-5",
        "ingredients" : [
          {
            "ingredientId" : "ingredient-pak-choi-1ecaba5438"
          },
          {
            "ingredientId" : "ingredient-steamed-brown-rice-7eb8b7e46d"
          },
          {
            "ingredientId" : "ingredient-gochujang-paste-f37667f68c"
          },
          {
            "ingredientId" : "ingredient-tamari-12723e2d6a"
          },
          {
            "ingredientId" : "ingredient-honey-da82b6e865"
          }
        ],
        "text" : "Add the pak choi, rice and remaining gochujang sauce. Break up the rice with a wooden spoon and cook for 4 minutes, stirring regularly, until the vegetables are tender and the rice is piping hot."
      },
      {
        "id" : "step-6",
        "ingredients" : [
          {
            "ingredientId" : "ingredient-free-range-pork-mince-1bb1f801d2"
          },
          {
            "amount" : 1,
            "ingredientId" : "ingredient-sesame-oil-a5aa314147",
            "unit" : "tsp"
          }
        ],
        "text" : "Return the pork to the pan and add 1 tsp of the toasted sesame oil. Toss everything together and cook for 2 minutes until hot."
      },
      {
        "id" : "step-7",
        "ingredients" : [
          {
            "ingredientId" : "ingredient-eggs-1ad708ac36"
          }
        ],
        "text" : "Meanwhile, heat a non-stick frying pan over a medium heat. Crack in the eggs and cook for 3 minutes until the whites are set but the yolks are still runny."
      },
      {
        "id" : "step-8",
        "ingredients" : [
          {
            "ingredientId" : "ingredient-spring-onions-f848e8aee7"
          },
          {
            "ingredientId" : "ingredient-sesame-seeds-1486bc3d5b"
          },
          {
            "amount" : 1,
            "ingredientId" : "ingredient-limes-cecbcd8c8f"
          },
          {
            "amount" : 1,
            "ingredientId" : "ingredient-sesame-oil-a5aa314147",
            "unit" : "tsp"
          }
        ],
        "text" : "Divide the pork and rice between bowls. Top each with a fried egg, spring onions and sesame seeds. Drizzle over the remaining 1 tsp sesame oil and serve with wedges of the remaining lime."
      }
