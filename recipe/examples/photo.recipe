          {
            "ingredientId" : "83fd7b46-c747-46d2-bfc7-1ba64ecbb575"
          },
          {
            "ingredientId" : "f9a24931-1d49-422c-92b9-fd1724d0106a"
          }
        ],
        "text" : "Heat the olive oil in a large deep frying pan over a medium-high heat. Add the sausagemeat and cook for 6 minutes, breaking it into bite-sized pieces with a wooden spoon, until well browned."
      },
      {
        "id" : "step-2",
        "ingredients" : [
          {
            "ingredientId" : "cdcf3718-219f-4c17-a41d-d81833bd991d"
          },
          {
            "ingredientId" : "f9fa4f8a-1d00-40d3-8d61-b0b5e3e86e33"
          }
        ],
        "text" : "Reduce the heat to medium. Add the onion with a pinch of salt and cook for 5 minutes until soft and lightly golden."
      },
      {
        "id" : "step-3",
        "ingredients" : [
          {
            "ingredientId" : "be90707e-0699-46a3-bc5a-fd42032d0e00"
          },
          {
            "ingredientId" : "bcbaef8c-bc49-4d3a-8afb-b497514d1bf2"
          },
          {
            "ingredientId" : "fa65e633-a6d1-4688-87eb-b115ae850c39"
          },
          {
            "ingredientId" : "a53e55ad-1722-4efa-8127-85ce6ba2c731"
          }
        ],
        "text" : "Add the garlic, chilli flakes, rosemary and tomato purée. Cook for 1 minute, stirring, until fragrant."
      },
      {
        "id" : "step-4",
        "ingredients" : [
          {
            "ingredientId" : "27795959-912e-40cc-a01b-7a93ece5ddba"
          },
          {
            "ingredientId" : "6b18ab64-061f-4995-ad95-7a34268e4baf"
          }
        ],
        "text" : "Pour in the chopped tomatoes and milk and stir well. Bring to a gentle simmer, then cook over a low heat for 15 minutes, stirring occasionally."
      },
      {
        "id" : "step-5",
        "ingredients" : [
          {
            "ingredientId" : "d4bb185b-d0c2-4863-abf5-3e5bafa0e81e"
          },
          {
            "ingredientId" : "f9fa4f8a-1d00-40d3-8d61-b0b5e3e86e33"
          }
        ],
        "text" : "Bring a large pan of well-salted water to the boil. Add the rigatoni and cook for 11 minutes until al dente, or adjust the cooking time if your packet specifies differently."
      },
      {
        "id" : "step-6",
        "ingredients" : [
          {
            "ingredientId" : "d4bb185b-d0c2-4863-abf5-3e5bafa0e81e"
          },
          {
            "amount" : 20,
            "ingredientId" : "cb50be8c-04a3-4b8d-a54e-849de7dc22cb",
            "unit" : "g"
          }
        ],
        "text" : "Reserve a mugful of the pasta water, then drain the rigatoni. Add it to the ragu with 20g of the Parmesan and toss over a medium heat for 2 minutes, adding a splash of pasta water if needed until the sauce coats the pasta."
      },
      {
        "id" : "step-7",
        "ingredients" : [
          {
            "amount" : 20,
            "ingredientId" : "cb50be8c-04a3-4b8d-a54e-849de7dc22cb",
            "unit" : "g"
          },
          {
            "ingredientId" : "0babdf45-1acc-483b-8b0a-4506360e7a25"
          },
          {
            "ingredientId" : "f9fa4f8a-1d00-40d3-8d61-b0b5e3e86e33"
          },
          {
            "ingredientId" : "dd756255-be70-4696-971c-edc43d566151"
          }
        ],
        "text" : "Taste and season with salt and black pepper. Divide between bowls and finish with the remaining Parmesan and chopped parsley."
      }
